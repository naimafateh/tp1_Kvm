#cloud-config
preserve_hostname: false
hostname: app02
manage_etc_hosts: true
ssh_deletekeys: true
ssh_genkeytypes: [rsa, ecdsa, ed25519]
ssh_pwauth: false
disable_root: true
users:
  - default
  - name: etudiant
    groups: [adm]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMs0DK8kSq2+K+s7BFeXtETZkpZIL066EE7dTbo36fWK tp1-kvm
write_files:
  - path: /etc/tp-instance
    permissions: '0644'
    content: |
      Instance : app02
      Reference : ubuntu-template-v1
